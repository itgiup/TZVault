{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TZVault",
  "version": "0.1.0",
  "identifier": "com.u.TZVault",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TZVault",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "itgiup",
    "homepage": "https://github.com/itgiup/TZVault",
    "shortDescription": "Encrypted local private key manager",
    "longDescription": "TZVault stores SSH keys, crypto wallets, PGP keys, and API keys, encrypting everything locally with AES-256-GCM before it touches disk.",
    "copyright": "Copyright (c) 2026 itgiup",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}